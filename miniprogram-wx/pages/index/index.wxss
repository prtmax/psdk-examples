/**index.wxss**/
.radio {
  background-color: #FFFFFF;
  position: relative;
  display: flex;
  flex-direction: row;
}
.title {
  max-lines: 1;
  font-size: 30rpx;
  font-weight: 500;
  padding: 20rpx 0;
  line-height: 1.5;
}
.list-cell-pd {
  padding: 22rpx 30rpx;
}
.userinfo {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #aaa;
}

.userinfo-avatar {
  overflow: hidden;
  width: 128rpx;
  height: 128rpx;
  margin: 20rpx;
  border-radius: 50%;
}

.usermotto {
  margin-top: 200px;
}

.esc-panel {
  width: 100%;
  margin-top: 16rpx;
  padding: 0 20rpx 20rpx;
  box-sizing: border-box;
}

.esc-actions {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.esc-actions .button {
  flex: 1;
  margin: 0;
}

.esc-result,
.esc-events {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 16rpx;
  background-color: #f7f7f7;
}

.esc-events-title {
  font-weight: 600;
}

.esc-event {
  color: #555;
  font-size: 26rpx;
}
