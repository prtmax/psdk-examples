<view class="center">
  <view class="radio">
			<view >指令选择:</view>
			<radio-group class="radio" bindchange="radioChange">
				<label class="list-cell-pd" wx:for="{{items}}" wx:key="index">
					<view>
						<radio value="{{item.type}}" checked="{{item.checked}}" style="transform:scale(0.8)"/>
					</view>
					<view>{{item.type}}</view>
				</label>
			</radio-group>
		</view>
	<button bindtap="openBluetooth" class="button">开始搜索</button>
	<button bindtap="closeBluetooth" class="button">断开连接</button>
  <button wx:if="{{!isEsc}}" bindtap="writeModel" class="button">打印76*130模版</button>
  <button bindtap="writeImage" class="button">打印图片</button>
  <button wx:if="{{!isEsc}}" bindtap="writeTsplRibbonModel" class="button">打印热转印测试</button>
  <view wx:if="{{isEsc}}" class="esc-panel">
    <view class="esc-actions">
      <button bindtap="queryEscStatus" class="button">查询状态</button>
      <button bindtap="queryEscBattery" class="button">查询电量</button>
      <button bindtap="queryEscSn" class="button">查询SN</button>
    </view>
    <view class="esc-result">
      <text>状态：{{escStatus}}</text>
      <text>电量：{{escBattery}}</text>
      <text>SN：{{escSn}}</text>
    </view>
    <view wx:if="{{escEvents.length}}" class="esc-events">
      <text class="esc-events-title">打印机事件</text>
      <view wx:for="{{escEvents}}" wx:for-item="event" wx:for-index="index" wx:key="index" class="esc-event">
        <text>{{event.time}} {{event.message}}</text>
      </view>
    </view>
  </view>
</view>
<view class="venues_list">
  <block wx:for="{{discoveredDevices}}" wx:for-item="item" wx:key="index">
    <view class="venues_item">
      <text class="status">设备名称:{{item.name}}</text>
      <text class="status">设备ID:{{item.deviceId}}</text>
      <text class="status">连接状态:{{connectedDeviceId == item.deviceId?"已连接":"未连接"}}</text>
    
      <view class="section">
        <button type="warn" class="button" id="{{index}}" bindtap="connectTO">连接</button>
      </view>
    </view>
  </block>
</view>
