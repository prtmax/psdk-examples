<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 扫描区域 -->
    <LinearLayout
        android:id="@+id/scan_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/round_boder"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_scan_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="扫描附近设备"
            android:textStyle="bold"
            android:textSize="20dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_scan_des"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="手机尽量靠近要添加的设备"
            android:textColor="#666666"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/bt_start_bleScan"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:text="开始扫描"
            android:layout_marginBottom="8dp" />

        <ListView
            android:id="@+id/lv_bluetooth_devices"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="#f5f5f5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bt_start_bleScan"
            app:layout_constraintBottom_toBottomOf="parent"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- WiFi模式选择区域 -->
    <LinearLayout
        android:id="@+id/wifi_mode_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/round_boder"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_wifi_mode_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="目前wifi设置模式是，是否切换？"
            android:textSize="16dp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:layout_marginTop="15dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- 新添加的"切换"按钮 -->
            <Button
                android:id="@+id/btn_switch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="切换"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- 不切换按钮 -->
            <Button
                android:id="@+id/btn_no_switching"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="不切换"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:layout_marginLeft="16dp"
                app:layout_constraintStart_toEndOf="parent" />
        </LinearLayout>


    </LinearLayout>

    <!-- 输入SSID/密码区域 -->
    <LinearLayout
        android:id="@+id/wifi_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/round_boder"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="gone">

        <!-- 设备名称 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_wifi_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SSID："
                android:textSize="16dp"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/tv_wifi_SSID"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="请输入Wi-Fi名称"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:background="#806750A4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <!--                    <Button-->
            <!--                        android:id="@+id/btn_select_wifi"-->
            <!--                        android:layout_width="wrap_content"-->
            <!--                        android:layout_height="wrap_content"-->
            <!--                        android:text="选择 Wi-Fi"-->
            <!--                        android:textSize="10dp"/>-->
        </LinearLayout>

        <!-- 密码输入区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tv_password_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="密码："
                android:textSize="16dp"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/edit_wifi_password"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="请输入 Wi-Fi 密码"
                android:textColor="#FFFFFF"
                android:background="#806750A4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!--                    <ImageView-->
            <!--                        android:id="@+id/btn_show_password"-->
            <!--                        android:layout_width="24dp"-->
            <!--                        android:layout_height="24dp"-->
            <!--                        android:background="#E6E0E9"-->
            <!--                        android:layout_marginEnd="8dp"-->
            <!--                        android:contentDescription="显示密码"/>-->
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- 新添加的"上一步"按钮 -->
            <Button
                android:id="@+id/btn_previous"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="上一步"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- 下一步按钮 -->
            <Button
                android:id="@+id/btn_next"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="下一步"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:layout_marginLeft="16dp"
                app:layout_constraintStart_toEndOf="parent" />

        </LinearLayout>
    </LinearLayout>

    <!-- wifi连接成功区域 -->
    <LinearLayout
        android:id="@+id/wifi_success_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/round_boder"
        android:padding="8dp"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_abtain_wifi_ip_success"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:text="已更新Ip:Port，可直接连接打印机了！"
            android:textSize="16dp"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <Button
            android:id="@+id/btn_scan_again"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="重新扫描"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"
            app:layout_constraintStart_toEndOf="parent" />
    </LinearLayout>

</LinearLayout>
